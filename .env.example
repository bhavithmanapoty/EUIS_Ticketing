# Supabase (Project Settings -> API Keys). The publishable key is safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 64 hex chars (32 bytes) for AES-256-GCM QR encryption: `openssl rand -hex 32`
# Never change this after tickets are sent, or every existing QR becomes invalid.
QR_SECRET_KEY=

# Gmail account that sends tickets. Needs 2-Step Verification + an App Password
# (Google Account -> Security -> App passwords).
GMAIL_USER=
GMAIL_APP_PASSWORD=
